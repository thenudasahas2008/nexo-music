# Nexo Music Configuration

# Discord Bot Token (required)
TOKEN=

# Bot Brand & Presence
BOT_NAME=Nexo
DEFAULT_LANGUAGE=en
LOG_LEVEL=info
OWNER_DISCORD_ID=
SUPPORT_SERVER_INVITE=
SUPPORT_GUILD_ID=

# Private Lavalink Node (optional — leave blank to use auto-scored public Lavalink v4 pool)
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Public Node Pool Settings
PUBLIC_NODE_ENABLED=true
PUBLIC_NODE_HOST_ALLOWLIST=
MAX_ACTIVE_NODES=3
LAVALINK_HEALTH_CHECK_INTERVAL_MS=25000
LAVALINK_MAX_RECONNECT_ATTEMPTS=15
LAVALINK_BASE_DELAY_MS=1000
LAVALINK_MAX_DELAY_MS=15000

# Playback & Quality Defaults
DEFAULT_VOLUME=80
DEFAULT_SEARCH_PLATFORM=ytmsearch
AUTOPLAY_DEFAULT=false
AUTOPLAY_TARGET_COUNT=20
QUEUE_EMPTY_DESTROY_MS=45000
EMPTY_CHANNEL_DESTROY_MS=60000
ALLOWED_ROLES=

# Optional Spotify Metadata Enrichment
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
